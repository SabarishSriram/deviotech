# Supabase → Project Settings → API Keys.
# Locally these go in .env.local; in production, Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-only — never expose it to the browser.
SUPABASE_SECRET_KEY=

# Admin portal (/admin)
ADMIN_USERNAME=admin
# A long, unique password only you know.
ADMIN_PASSWORD=
# Random string of 32+ characters used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Email (Nodemailer over SMTP). Free option: Gmail + an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. With Gmail this must be the same address as SMTP_USER.
MAIL_FROM=
